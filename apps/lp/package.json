{
  "name": "lp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "vp build",
    "typecheck": "tsc --runExternalCode",
    "test": "vp test run --passWithNoTests",
    "steiger": "steiger ./src",
    "fallow": "fallow --skip dupes --fail-on-issues --quiet --format compact && fallow dupes --fail-on-issues --quiet --format compact && fallow security --fail-on-issues --quiet",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy"
  },
  "dependencies": {
    "@codemirror/autocomplete": "catalog:",
    "@codemirror/lang-javascript": "catalog:",
    "@codemirror/lint": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@effect/atom-react": "catalog:stack",
    "@tanstack/react-router": "1.170.46",
    "@typescript/vfs": "catalog:",
    "@valtown/codemirror-ts": "catalog:",
    "codemirror": "catalog:",
    "comlink": "catalog:",
    "effect": "catalog:stack",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rpp-kit": "workspace:*",
    "security-headers": "workspace:*",
    "tailwindcss": "catalog:stack",
    "typescript-6": "catalog:"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "catalog:stack",
    "@alchemy.run/fly": "catalog:stack",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:stack",
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/react-start": "catalog:stack",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "catalog:",
    "alchemy": "catalog:stack",
    "node-html-parser": "9.0.6",
    "steiger": "catalog:stack",
    "twoslash": "catalog:",
    "typescript": "catalog:stack",
    "vite": "catalog:",
    "vite-plus": "catalog:stack"
  }
}
